# Farlight Skin Changer - local configuration
# Copy this file to .env and fill in your local paths.
# Real environment variables take precedence over this file.

# Path to the game's main executable (for Ghidra analysis)
FL_GAME_EXE=D:\Path\To\Farlight84\WindowsClient\Solarland\Binaries\Win64\SolarlandClient-Win64-Shipping.exe

# Hot-patch pak mount folder the game downloads to
FL_PAK_DIR=C:\Users\YOUR_WINDOWS_USER\AppData\Local\Solarland\Saved_Steam\Paks

# Ghidra install (for the headless analysis scripts)
FL_GHIDRA_PATH=D:\Path\To\ghidra_PUBLIC

# Ghidra JVM heap for headless runs
FL_GHIDRA_MAXMEM=16G

# Where the GUI tails the Ghidra analysis log from
FL_GHIDRA_LOG=D:\Path\To\Repo\tools\ghidra_analysis.log
